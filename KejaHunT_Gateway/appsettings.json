                        "Path": "/health"
                    }
                },
                "LoadBalancingPolicy": "RoundRobin"
            },
            "propertyService": {
                "Destinations": {
                    "properties": {
                        "Address": "https://localhost:7209/"
                    }
                },
                "HealthCheck": {
                    "Active": {
                        "Enabled": true,
                        "Interval": "00:00:10",
                        "Timeout": "00:00:05",
                        "Policy": "ConsecutiveFailures",
                        "Path": "/health"
                    }
                },
                "LoadBalancingPolicy": "RoundRobin"
            },
            "accessService": {
                "Destinations": {
                    "access": {
                        "Address": "https://localhost:7159/"
                    }
                },
                "HealthCheck": {
