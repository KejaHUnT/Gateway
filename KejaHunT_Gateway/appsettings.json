    "ReverseProxy": {
        "Clusters": {
            "fileHandlerService": {
                "Destinations": {
                    "files": {
                        "Address": "https://localhost:7115/"
                    }
                },
                "HealthCheck": {
                    "Active": {
                        "Enabled": true,
