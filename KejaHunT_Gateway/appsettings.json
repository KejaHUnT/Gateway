            },
            "properties": {
                "ClusterId": "propertyService",
                "Match": {
                    "Path": "/properties/{**catch-all}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/properties" }
                ]
            },
            "access": {
                "ClusterId": "accessService",
                "Match": {
                    "Path": "/access/{**catch-all}"
                },
                "Transforms": [
                    { "PathRemovePrefix": "/access" }
                ]
            }
        }
